# Minimal reproducible ImmortalWrt 24.10.6 Netcore N60 Pro image.
# Preserve the device's open-source mt76/mt7915e driver packages.
CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_filogic=y
CONFIG_TARGET_mediatek_filogic_DEVICE_netcore_n60-pro=y
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-ssl=y
CONFIG_PACKAGE_luci-i18n-base-zh-tw=y

# Reuse compiled objects across Actions runs (cached separately from secrets).
CONFIG_CCACHE=y
